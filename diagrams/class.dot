digraph C {
graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.35, ranksep=0.5];
node [shape=record, style="filled", fontname="Times New Roman", fontsize=10, color="#2F5597", fillcolor="#F7FBFF"];
edge [fontname="Times New Roman", fontsize=9, color="#555555"];
s [label="{BookingService|+ MIN_DURATION = 15 мин Duration\l+ BASE_MAX_HOURS = 8 int\l+ MAX_MODIFIER_PERCENT = 25 int\l+ MAX_DURATION = 600 мин Duration\l- repo BookingRepository\l- buffer Duration\l|+ BookingService(BookingRepository)\l+ BookingService(BookingRepository, Duration)\l+ book(String, String, LocalDateTime, LocalDateTime, LocalDateTime) Booking\l+ isAvailable(String, LocalDateTime, LocalDateTime) boolean\l~ overlaps(Booking, LocalDateTime, LocalDateTime) boolean\l- checkInterval(LocalDateTime, LocalDateTime) void\l}"];
r [label="{BookingRepository|- data List[Booking]\l|+ save(Booking) void\l+ findByRoom(String) List[Booking]\l+ findById(String) Booking\l+ size() int\l}"];
b [label="{«record» Booking|- id String\l- roomId String\l- start LocalDateTime\l- end LocalDateTime\l|+ duration() Duration\l}"];
ex [label="{BookingConflictException|- conflictId String\l|+ getConflictId() String\l}"];
s -> r [label="1",arrowtail=odiamond,dir=both];
r -> b [label="0..*",arrowtail=odiamond,dir=both];
s -> ex [label="throws",style=dashed,arrowhead=open];
}
