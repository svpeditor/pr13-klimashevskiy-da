digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.3, ranksep=0.35];
node [shape=box, style="rounded,filled", fontname="Times New Roman", fontsize=11, color="#2F5597", fillcolor="#EAF2F8", margin="0.12,0.08"];
edge [fontname="Times New Roman", fontsize=9, color="#555555"];
start [label="Начало", shape=oval, fillcolor="#E2F0D9", color="#548235"];
end [label="Завершение", shape=oval, fillcolor="#FCE4D6", color="#C65911"];
n1 [label="Получить комнату, интервал start - end и clockNow" ,shape=parallelogram,fillcolor="#E4DFEC",color="#7030A0"];
n2 [label="A1 Проверить границы времени:\nend позже start, длительность\nот 15 мин до 10 ч (600 мин),\nstart не раньше clockNow,\nid еще не занят"];
n2d [label="Интервал корректен" ,shape=diamond,fillcolor="#FFF2CC",color="#BF9000"];
n3 [label="Найти бронирования комнаты\nrepo.findByRoom(room)"];
n4 [label="Проверить пересечение\nс каждым интервалом:\nstart < b.end + буфер и\nb.start < end + буфер"];
n5 [label="Есть конфликт" ,shape=diamond,fillcolor="#FFF2CC",color="#BF9000"];
n6 [label="Создать Booking\nи сохранить в репозиторий"];
n7 [label="Вернуть конфликт:\nBookingConflictException\nс id бронирования"];
n8 [label="Вернуть ошибку\nIllegalArgumentException"];
start -> n1;
n1 -> n2;
n2 -> n2d;
n2d -> n3 [label="да"];
n2d -> n8 [label="нет"];
n3 -> n4;
n4 -> n5;
n5 -> n7 [label="да"];
n5 -> n6 [label="нет"];
n6 -> end;
n7 -> end;
n8 -> end;
}
